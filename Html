    <!-- LÓGICA JAVASCRIPT INTEGRADA -->
    <script>
        // Variáveis de Estado
        let saldoAtual = 8500.00;
        let ganhoAoVivo = 348.25;

        // Alternador de Abas do Menu
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.add('hidden');
                tab.classList.remove('block');
            });

            const selectedTab = document.getElementById('tab-' + tabId);
            if (selectedTab) {
                selectedTab.classList.remove('hidden');
                selectedTab.classList.add('block');
            }

            // Atualiza botões ativos
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-brand-card', 'text-brand-neon');
            });
        }

        // Copiar Texto para área de transferência
        function copyText(text) {
            navigator.clipboard.writeText(text);
            showToast('Copiado com sucesso: ' + text, 'success');
        }

        // Notificações Toast Flutuantes
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `p-3 rounded-lg text-xs font-bold text-white shadow-xl flex items-center space-x-2 transition-all transform duration-300 border ${
                type === 'success' ? 'bg-brand-dark border-brand-green text-brand-neon' : 'bg-gray-800 border-gray-700'
            }`;
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-brand-green"></i> <span>${message}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 4000);
        }

        // Simulação de Crescimento Diário em Tempo Real (Contador Automático)
        setInterval(() => {
            ganhoAoVivo += 0.05;
            const liveElement = document.getElementById('live-counter');
            if (liveElement) {
                liveElement.innerText = '+' + ganhoAoVivo.toFixed(2) + ' Kz';
            }
        }, 1500);

        // Gerador de Notificações Automáticas de Outros Utilizadores (Simulação Realista)
        const nomesSimulados = ['+244 923***102', '+244 945***891', '+244 912***443', '+244 931***002'];
        const operacoesSimuladas = [
            { tipo: 'Depósito', valor: '1.000,00 Kz', metodo: 'Entidade/Ref' },
            { tipo: 'Levantamento', valor: '3.000,00 Kz', metodo: 'Express' },
            { tipo: 'Levantamento', valor: '6.500,00 Kz', metodo: 'IBAN BAI' },
            { tipo: 'Depósito', valor: '1.000,00 Kz', metodo: 'IBAN BIC' }
        ];

        function populateTransactions() {
            const tbody = document.getElementById('live-transactions-table');
            if (!tbody) return;
            
            tbody.innerHTML = '';
            for (let i = 0; i < 5; i++) {
                const user = nomesSimulados[Math.floor(Math.random() * nomesSimulados.length)];
                const op = operacoesSimuladas[Math.floor(Math.random() * operacoesSimuladas.length)];
                
                const row = document.createElement('tr');
                row.className = 'border-b border-gray-800 hover:bg-black/20';
                row.innerHTML = `
                    <td class="p-3 font-mono">${user}</td>
                    <td class="p-3 font-semibold ${op.tipo === 'Depósito' ? 'text-brand-green' : 'text-emerald-400'}">${op.tipo}</td>
                    <td class="p-3 font-bold text-white">${op.valor}</td>
                    <td class="p-3 text-gray-400">${op.metodo}</td>
                    <td class="p-3"><span class="px-2 py-0.5 bg-brand-green/20 text-brand-neon rounded text-[10px]">Concluído</span></td>
                `;
                tbody.appendChild(row);
            }
        }

        // Notificação Dinâmica Popup
        setInterval(() => {
            const user = nomesSimulados[Math.floor(Math.random() * nomesSimulados.length)];
            const op = operacoesSimuladas[Math.floor(Math.random() * operacoesSimuladas.length)];
            showToast(`${user} acabou de efetuar um ${op.tipo} de ${op.valor}`, 'success');
        }, 12000);

        // Submissão do Depósito
        function confirmDeposit(e) {
            e.preventDefault();
            showToast('Comprovativo enviado! O valor de 1.000 Kz será creditado em instantes.', 'success');
            setTimeout(() => switchTab('dashboard'), 2000);
        }

        // Processamento de Levantamento (Validação Mínima de 3000 Kz)
        function processWithdrawal(e) {
            e.preventDefault();
            const amountInput = document.getElementById('withdraw-amount');
            const valor = parseFloat(amountInput.value);

            if (valor < 3000) {
                showToast('Erro: O valor mínimo de levantamento é de 3.000 Kz.', 'info');
                return;
            }

            if (valor > saldoAtual) {
                showToast('Erro: Saldo insuficiente para efetuar o saque.', 'info');
                return;
            }

            saldoAtual -= valor;
            document.getElementById('saldo-display').innerText = saldoAtual.toLocaleString('pt-AO') + ',00 Kz';
            document.getElementById('saldo-levantamento-display').innerText = saldoAtual.toLocaleString('pt-AO') + ',00 Kz';

            showToast(`Solicitação de ${valor.toLocaleString('pt-AO')} Kz enviada com sucesso para o seu IBAN!`, 'success');
            setTimeout(() => switchTab('dashboard'), 2000);
        }

        // Renderização do Gráfico de Crescimento (Chart.js)
        window.onload = function() {
            populateTransactions();

            const ctx = document.getElementById('growthChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Dia 1', 'Dia 2', 'Dia 3', 'Dia 4', 'Dia 5', 'Dia 6', 'Hoje (Ao Vivo)'],
                    datasets: [{
                        label: 'Crescimento do Saldo (Kz)',
                        data: [1000, 2500, 4000, 5500, 7000, 8000, 8500],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 5,
                        pointBackgroundColor: '#00ff87'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#9ca3af' }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#1f2937' },
                            ticks: { color: '#9ca3af' }
                        },
                        y: {
                            grid: { color: '#1f2937' },
                            ticks: { color: '#9ca3af' }
                        }
                    }
                }
            });
        };
    </script>
